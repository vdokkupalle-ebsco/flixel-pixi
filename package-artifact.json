      "pixi.js": "^8.19.0"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "dist/index.d.ts",
    "dist/index.js",
